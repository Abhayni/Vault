# ==============================================================================
# MOD VAULT — Environment Configuration Template (Google Drive + Supabase)
# ==============================================================================
# Copy this file to `.env` for local or hosted Node/Express deployment.
# NEVER commit `.env` or expose SUPABASE_SERVICE_ROLE_KEY in VITE_* variables.

# ------------------------------------------------------------------------------
# 1. Owner Access Control (REQUIRED — single-user private vault)
# ------------------------------------------------------------------------------
OWNER_EMAIL="abhayn20234@gmail.com"

# ------------------------------------------------------------------------------
# 2. Supabase Auth & PostgreSQL Metadata Database (REQUIRED)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Server-only Service Role Key (never prefixed with VITE_ and never sent to browser)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Client-side Supabase config (optional if relying on runtime /api/config)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ------------------------------------------------------------------------------
# 3. Google Drive Upload Limits & File Type Rules
# ------------------------------------------------------------------------------
# Single-file upload ceiling in MB (default 5120 MB = 5 GB per file via resumable uploads)
MAX_UPLOAD_MB="5120"

# Allowed extensions for File Manager uploads:
# Use "*" to allow all file types, or comma-separated extensions e.g.:
# ".jar,.zip,.rar,.7z,.mrpack,.schematic,.pdf,.txt,.json,.png,.jpg,.jpeg,.webp"
ALLOWED_FILE_EXTENSIONS="*"

# App URL used for password reset redirect links
APP_URL="http://localhost:3000"
